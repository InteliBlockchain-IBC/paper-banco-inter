# Configuração do benchmark. Copie para .env (o .env nunca vai para o git).
# Só três blocos precisam de preenchimento: carteira, RPCs (opcional) e Canton.

# ─── 1. Carteira com os tokens de faucet ──────────────────────────────────────
# Chave privada (0x...) da carteira que recebeu os faucets. Ela vira o admin do experimento
# e financia as outras 12 contas (ofertante, tomador e 10 tomadores do T2), derivadas
# automaticamente desta chave. Use uma carteira SÓ DE TESTE, sem fundos reais.
# Na MetaMask: Detalhes da conta → Mostrar chave privada.
PRIVATE_KEY=

# Opcional: uma chave diferente por rede (tem prioridade sobre PRIVATE_KEY).
SEPOLIA_PRIVATE_KEY=
FUJI_PRIVATE_KEY=
MONAD_PRIVATE_KEY=

# Alternativa à PRIVATE_KEY: um mnemonic de teste (`npm run carteiras -- nova` gera um).
MNEMONIC=

# Tomadores extras do T2
N_TOMADORES_T2=10

# ─── 2. RPCs (vazio = RPC público de config/redes.json) ───────────────────────
# Use o mesmo tipo de RPC em todas as redes (seção 4.4 do roteiro).
SEPOLIA_RPC_URL=
FUJI_RPC_URL=
MONAD_RPC_URL=
BESU_RPC_URL=http://127.0.0.1:8545
TIPO_RPC=público gratuito
REGIAO=

# RPCs de mainnet, usados só para ler o preço de referência do gas (C4-M1)
ETH_MAINNET_RPC_URL=
AVAX_MAINNET_RPC_URL=
MONAD_MAINNET_RPC_URL=

# ─── 3. Canton (JSON Ledger API v2 do LocalNet do cn-quickstart) ──────────────
# Endereço da JSON API do participante. App Provider = 3975, App User = 2975.
CANTON_API=http://localhost:3975
# Token de acesso ao ledger.
#  - LocalNet com OAuth2 (resposta "y" no make setup): token emitido pelo Keycloak do LocalNet.
#  - LocalNet com shared-secret (resposta "n"): JWT assinado com o segredo configurado no setup.
CANTON_TOKEN=
# Usuário do ledger dono do token, com direito de agir pelas partes criadas. [CONFERIR no LocalNet]
CANTON_USER_ID=participant_admin
# Referência do pacote Daml: "#" + o name do canton/daml/daml.yaml
CANTON_PACOTE="#credit-interbank"

# ─── Parâmetros da coleta (iguais em todas as redes; não altere sem registrar) ─
WEB3_REPO=../../projeto-inter-web3
TEMPO_LIMITE_S=300
MULTIPLICADOR_GAS=1.2
